# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# For a single-origin production container, set this to the public site URL.
# Example: https://roomlink.example.com
ROOM_TTL_MINUTES=1440
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret. Never expose this as VITE_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Web (Vite reads variables prefixed with VITE_)
VITE_API_URL=http://localhost:3001
