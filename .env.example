# Optional legacy server (only used by the local Socket.IO development server)
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
ROOM_TTL_MINUTES=1440
SUPABASE_URL=https://your-project.supabase.co
# Server-only legacy persistence secret. Never expose it as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Web (Vite exposes only VITE_ variables to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key
